      "number": 18,
      "points": 8,
      "stem": "Find the interval of convergence for the series $\\sum_{n=0}^{\\infty} \\frac{(x - 4)^n}{n^5 3^n}$",
      "choices": [
        {
          "label": "A",
          "text": "$[3, 5]$"
