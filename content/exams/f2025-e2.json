          "label": "A",
          "text": "$r(x) = 4x - 3$"
        },
        {
          "label": "B",
          "text": "$r(x) = 4x + 3$"
        },
        {
          "label": "C",
          "text": "$r(x) = -4x$"
        },
        {
          "label": "D",
          "text": "$r(x) = 3$"
        },
        {
          "label": "E",
          "text": "$r(x) = -4x + 3$"
        }
      ],
      "answer": "A",
      "lessonIds": [
        "L17"
      ],
      "sourcePage": 3,
