        },
        {
          "label": "B",
          "text": "$\\frac{A}{x + 3} + \\frac{B}{x - 1} + \\frac{Cx + D}{x^2 + 2x + 1} + \\frac{Ex + F}{x^2 + 2x + 5}$"
        },
        {
          "label": "C",
          "text": "$\\frac{A}{x - 3} + \\frac{B}{x + 1} + \\frac{C}{x - 1} + \\frac{D}{(x + 1)^2} + \\frac{E}{x^2 + 2x + 5}$"
