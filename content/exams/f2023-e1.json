          "label": "A",
          "text": "$\\mathbf{u}$ and $\\mathbf{v}$ are parallel and in the same direction."
        },
        {
          "label": "B",
          "text": "$\\mathbf{u}$ and $\\mathbf{v}$ are parallel and in the opposite directions."
        },
        {
          "label": "C",
          "text": "$\\mathbf{u}$ and $\\mathbf{v}$ are perpendicular."
        },
        {
          "label": "D",
          "text": "Always true for all $\\mathbf{u}$ and $\\mathbf{v}$"
        },
        {
          "label": "E",
          "text": "Never true for any $\\mathbf{u}$ and $\\mathbf{v}$"
